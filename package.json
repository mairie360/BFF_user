{
  "name": "bff-user",
  "version": "1.0.0",
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "openapi:extract": "tsx scripts/export-swagger.ts",
    "test": "jest",
    "contracts:generate": "npm run openapi:extract && node scripts/contracts.mjs --generate",
    "contracts:check": "npm run openapi:extract -- --check && node scripts/contracts.mjs --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@mairie360/core-api-openapi": "1.2.0",
    "axios": "^1.13.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "swagger-ui-express": "5.0.1",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.8",
    "@types/pg": "^8.20.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
